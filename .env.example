# ==========================================
# ELEVORA APP ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port (Dynamic in cloud platforms like Render/Railway)
PORT=8000
HOST=0.0.0.0

# Secure Secret Key for Session Authentication
SECRET_KEY=change-this-to-a-very-long-random-string-in-production

# ------------------------------------------
# DATABASE CONFIGURATION OPTIONS
# ------------------------------------------
# Option A: Cloud PostgreSQL (Neon / Supabase / Render / Railway)
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# Option B: Cloud MySQL (TiDB / PlanetScale / Railway)
# DATABASE_URL=mysql://username:password@gateway.tidbcloud.com:4000/elevora_db

# Option C: Individual Environment Variables
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=resume_gap_analyzer
# DB_TYPE=postgres

# Option D: SQLite (Default fallback - zero config needed!)
# If DATABASE_URL is omitted, SQLite will automatically be used.

# ------------------------------------------
# EMAIL (SMTP) VERIFICATION CONFIGURATION
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER=Elevora Verification <your_email@gmail.com>
SMTP_USE_TLS=true
